# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Comma-separated "label:sha256hex" entries. Create one with:
#   docker compose run --rm --no-deps mcp gen-token --label my-laptop
# The token itself goes to your MCP client; only its hash goes here.
CLAMAV_MCP_AUTH_TOKEN_HASHES=

# Host port (bound to 127.0.0.1 only).
MCP_PORT=8000

# MCP server image. Pin a release tag for reproducible deployments.
# MCP_IMAGE=ghcr.io/beecho01/mcp-clamav:1.0.0

# If clients reach the server under another name (e.g. via a reverse proxy), add it here,
# otherwise requests are rejected by DNS-rebinding protection (HTTP 421/403).
# CLAMAV_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,mcp.example.internal
# CLAMAV_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*

# OAuth 2.1 resource-server mode (instead of static tokens):
# CLAMAV_MCP_OAUTH_ISSUER=https://auth.example.com/realms/main
# CLAMAV_MCP_OAUTH_JWKS_URL=https://auth.example.com/realms/main/protocol/openid-connect/certs
# CLAMAV_MCP_OAUTH_RESOURCE_URL=https://mcp.example.com/mcp
# CLAMAV_MCP_OAUTH_REQUIRED_SCOPES=clamav:scan

# CLAMAV_MCP_MAX_INLINE_BYTES=10M
# CLAMAV_MCP_RATE_LIMIT_PER_MINUTE=30
# CLAMAV_MCP_LOG_LEVEL=INFO
